@model Product
@{
    bool isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Новый товар" : "Редактирование товара";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
}

<div class="form-box">
    <h3 class="page-title mt-0">@ViewData["Title"]</h3>

    <form asp-action="@(isNew ? "ProductCreate" : "ProductEdit")" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Category" class="form-label"></label>
            <select asp-for="Category" class="form-select">
                <option value="">— выберите —</option>
                @foreach (var c in categories)
                {
                    <option value="@c">@c</option>
                }
            </select>
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        </div>
        <div class="row">
            <div class="col-6 mb-3">
                <label asp-for="Price" class="form-label"></label>
                <!-- обычное текстовое поле, чтобы можно было писать цену через запятую -->
                <input asp-for="Price" type="text" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="col-6 mb-3">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Фото товара</label>
            <div class="d-flex gap-3 align-items-center mb-2">
                <img src="@ImageHelper.Product(Env, Model.ImageUrl)" alt=""
                     class="product-thumb" style="width:120px; height:90px;"
                     onerror="this.onerror=null; this.src='/images/products/no-photo.svg';" />
                <div class="flex-grow-1">
                    <input type="file" name="photo" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                    <div class="form-text">JPG, PNG или WEBP, до 5 МБ. Если файл не выбран, останется текущее фото.</div>
                </div>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="ImageUrl" class="form-label">Или путь / ссылка на картинку</label>
            <input asp-for="ImageUrl" class="form-control" placeholder="/images/products/... или https://..." />
        </div>
        <div class="form-check mb-3">
            <input asp-for="IsVisible" class="form-check-input" />
            <label asp-for="IsVisible" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-club">Сохранить</button>
        <a asp-action="Products" class="btn btn-outline-secondary">Отмена</a>
    </form>
</div>
