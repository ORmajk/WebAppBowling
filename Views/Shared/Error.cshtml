@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<h2 class="page-title text-danger">Произошла ошибка</h2>
<p>Что-то пошло не так. Попробуйте обновить страницу или вернуться на <a asp-controller="Home" asp-action="Index">главную</a>.</p>

@if (Model.ShowRequestId)
{
    <p><strong>Код запроса:</strong> <code>@Model.RequestId</code></p>
}
