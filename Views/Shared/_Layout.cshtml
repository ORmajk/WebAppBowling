@{
    var clientName = Context.Session.GetString("ClientName");
    var userName = Context.Session.GetString("UserName");
    var role = Context.Session.GetString("Role");
    var cartCount = Context.Session.GetInt32("CartCount") ?? 0;
    bool isManager = role == "Manager" || role == "Admin";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Голден Страйк</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg site-header">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">🎳 Голден Страйк</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainMenu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Главная</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="Index">Дорожки</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="Create">Забронировать</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Catalog" asp-action="Index">Бар и магазин</a></li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (!isManager)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Catalog" asp-action="Cart">🛒 Корзина (@cartCount)</a>
                            </li>
                        }
                        @if (clientName != null)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Profile">👤 @clientName</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Logout">Выйти</a></li>
                        }
                        else if (isManager)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Manager" asp-action="Index">👔 @userName</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Logout">Выйти</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Войти</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Регистрация</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
        @if (isManager)
        {
            <div class="manager-bar">
                <div class="container">
                    <b>Панель менеджера:</b>
                    <a asp-controller="Manager" asp-action="Index">Сводка</a>
                    <a asp-controller="Manager" asp-action="Bookings">Бронирования</a>
                    <a asp-controller="Manager" asp-action="Orders">Заказы</a>
                    <a asp-controller="Manager" asp-action="Products">Товары</a>
                    <a asp-controller="Manager" asp-action="Lanes">Дорожки</a>
                    <a asp-controller="Manager" asp-action="Clients">Клиенты</a>
                </div>
            </div>
        }
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success mt-3">@TempData["Message"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger mt-3">@TempData["Error"]</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            &copy; 2026 Боулинг-клуб «Голден Страйк» · Работаем ежедневно с 10:00 до 24:00
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
