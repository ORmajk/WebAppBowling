@{
    ViewData["Title"] = "Главная";
    var laneTypes = ViewBag.LaneTypes as List<LaneType> ?? new List<LaneType>();
    var events = ViewBag.Events as List<Event> ?? new List<Event>();
    var products = ViewBag.Products as List<Product> ?? new List<Product>();
}

<div class="hero">
    <h1>Боулинг-клуб «Голден Страйк»</h1>
    <p class="fs-5">Современные дорожки, VIP-зона, детские дорожки с бортиками, бар и кухня.<br />
        Бронируйте дорожку онлайн и заказывайте еду прямо к игре!</p>
    <a class="btn btn-light btn-lg me-2" asp-controller="Booking" asp-action="Create">Забронировать дорожку</a>
    <a class="btn btn-outline-light btn-lg" asp-controller="Catalog" asp-action="Index">Меню бара</a>
</div>

<h3 class="page-title">Наши дорожки</h3>
<div class="row g-3">
    @foreach (var type in laneTypes)
    {
        var lanes = type.Lanes.ToList();
        <div class="col-md-4">
            <div class="card-club">
                <img src="@ImageHelper.LaneType(Env, type.Name)" alt="@type.Name" class="product-photo mb-2" onerror="this.onerror=null; this.src='/images/lanes/Norm_lanes.jpg';" />
                <h5>@type.Name</h5>
                <p>@type.Description</p>
                @if (lanes.Count > 0)
                {
                    <p class="mb-1">Дорожек: @lanes.Count, до @lanes.Max(l => l.Capacity) человек</p>
                    <p class="price">от @lanes.Min(l => l.PricePerHour).ToString("N0") руб./час</p>
                }
            </div>
        </div>
    }
</div>

@if (events.Count > 0)
{
    <h3 class="page-title">Ближайшие мероприятия</h3>
    <div class="row g-3">
        @foreach (var ev in events)
        {
            <div class="col-md-4">
                <div class="card-club">
                    <h5>@ev.Name</h5>
                    <p class="mb-1"><b>@ev.EventDate.ToString("dd.MM.yyyy")</b></p>
                    <p>@ev.Description</p>
                </div>
            </div>
        }
    </div>
}

@if (products.Count > 0)
{
    <h3 class="page-title">Из меню бара</h3>
    <div class="row g-3">
        @foreach (var p in products)
        {
            <div class="col-md-3">
                <div class="card-club">
                    <img src="@ImageHelper.Product(Env, p.ImageUrl)" alt="@p.Name"
                         class="product-photo mb-2" onerror="this.onerror=null; this.src='/images/products/no-photo.svg';" />
                    <h5>@p.Name</h5>
                    <p class="text-muted mb-1">@p.Category</p>
                    <p class="price">@p.Price.ToString("N0") руб.</p>
                </div>
            </div>
        }
    </div>
    <p class="mt-3"><a asp-controller="Catalog" asp-action="Index">Смотреть всё меню →</a></p>
}

<h3 class="page-title">Как нас найти</h3>
<div class="card-club mb-4">
    <p class="mb-1">📍 Санкт-Петербург, ул. Боулинговая, д. 1</p>
    <p class="mb-1">📞 +7 (812) 000-00-00</p>
    <p class="mb-0">🕙 Ежедневно с 10:00 до 24:00</p>
</div>
